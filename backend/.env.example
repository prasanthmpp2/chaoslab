# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me

# Dry-run by default. Set true only on a disposable test environment.
CHAOS_EXECUTION_ENABLED=false

# API keys: JSON map of sha256(api_key) -> {user, roles}.  Generate: python scripts/make_api_key.py alice admin
CHAOS_API_KEYS='{}'

# Environment/target allowlist (JSON).
CHAOS_ENVIRONMENTS='{"docker-test":{"description":"disposable compose test bed","engines":["toxiproxy"],"max_duration_seconds":60,"max_targets":3,"services":{"payment-service":{"containers":["payment-service"],"toxiproxy_proxies":["payment-http"]}}}}'

# Probe destinations must be listed here (cloud metadata / link-local are always blocked).
CHAOS_PROBE_ALLOWED_HOSTS='["toxiproxy"]'

# Toxiproxy (management API on the private fault-mgmt network)
CHAOS_TOXIPROXY_URL=http://toxiproxy:8474
CHAOS_TOXIPROXY_DATA_HOST=toxiproxy

# Pumba / Docker (worker only; see docker-compose.pumba.yml)
CHAOS_PUMBA_PATH=pumba
CHAOS_DOCKER_ENABLED=false

# Chaos Toolkit
CHAOS_CHAOSTOOLKIT_PATH=chaos
CHAOS_CHAOSTOOLKIT_ALLOWED_MODULES='[]'

# Chaos Mesh (optional; leave disabled unless a cluster is configured)
CHAOS_CHAOS_MESH_ENABLED=false
# CHAOS_KUBECONFIG_PATH=/etc/chaos/kubeconfig
