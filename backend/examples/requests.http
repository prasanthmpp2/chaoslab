### Importable in VS Code REST Client / JetBrains HTTP Client. Set @key to your API key.
@base = http://localhost:8000
@key = REPLACE_ME

GET {{base}}/health/ready

###
GET {{base}}/api/v1/engines
X-API-Key: {{key}}

###
GET {{base}}/api/v1/engines/toxiproxy/capabilities
X-API-Key: {{key}}

###
POST {{base}}/api/v1/experiments
X-API-Key: {{key}}
Content-Type: application/json

{
  "apiVersion": "chaos.example.io/v1", "kind": "Experiment",
  "metadata": {"name": "payment-latency-test", "version": "1"},
  "spec": {
    "target": {"environment": "docker-test", "service": "payment-service"},
    "fault": {"engine": "toxiproxy", "type": "network-latency", "durationSeconds": 30,
              "parameters": {"proxy": "payment-http", "latencyMs": 500, "jitterMs": 100}},
    "hypothesis": {"maxErrorRate": 0.02, "maxP95LatencyMs": 1500},
    "safety": {"environmentAllowlist": ["docker-test"], "maxDurationSeconds": 60, "abortOnErrorRate": 0.1},
    "probes": [{"name": "payment-via-proxy", "url": "http://toxiproxy:8000/"}]
  }
}

###  (use the id from the response above)
POST {{base}}/api/v1/experiments/EXPERIMENT_ID/approve
X-API-Key: {{key}}

###
POST {{base}}/api/v1/experiments/EXPERIMENT_ID/runs
X-API-Key: {{key}}

###
GET {{base}}/api/v1/runs/RUN_ID
X-API-Key: {{key}}

###
GET {{base}}/api/v1/runs/RUN_ID/report
X-API-Key: {{key}}

###
POST {{base}}/api/v1/runs/RUN_ID/cancel
X-API-Key: {{key}}

###
GET {{base}}/api/v1/faults/active
X-API-Key: {{key}}
